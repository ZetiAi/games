# Copy to .env when running the app directly on your machine (`pnpm dev`).
# `docker compose up` does not need this file.

# --- Local development against the Firebase emulators -----------------------
# With VITE_USE_EMULATOR=true the app talks to the Auth and Firestore emulators
# started by `docker compose up` and needs no real Firebase project.
VITE_USE_EMULATOR=true
VITE_PROJECT_ID=demo-games
# Host of the emulators. Empty = the host the page was loaded from.
VITE_EMULATOR_HOST=
VITE_AUTH_EMULATOR_PORT=9099
VITE_FIRESTORE_EMULATOR_PORT=8080
# Base URL of the AI service (POST /play). Empty = the local stand-in on :8787.
VITE_API_AI=

# --- Real Firebase project (set VITE_USE_EMULATOR=false) ---------------------
VITE_API_KEY=
VITE_AUTH_DOMAIN=
VITE_STORAGE_BUCKET=
VITE_MESSAGING_SENDER_ID=
VITE_APP_ID=
