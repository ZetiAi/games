rules_version = '2';

// Rules for the LOCAL EMULATOR only. They require a signed-in user (a guest
// counts: guests are Firebase anonymous users) and nothing more. They are
// deliberately permissive so the existing client code works unchanged; do not
// deploy them to a real project.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}
