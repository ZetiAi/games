		"@types/cookie": "^0.5.1",
		"svelte": "^3.46.0",
		"svelte-check": "^2.7.1",
		"svelte-preprocess": "^4.10.6",
		"tslib": "^2.3.1",
		"typescript": "^4.7.4",
		"vite": "^3.0.5"
	},
	"type": "module",
	"dependencies": {
		"@fontsource/fira-mono": "^4.5.0",
		"@fortawesome/free-solid-svg-icons": "^6.1.2",
		"@fortawesome/free-regular-svg-icons": "^6.1.2",
		"chess": "file:packages/chess",
		"cm-chessboard": "^5.0.1",
		"cookie": "^0.4.1",
		"firebase": "^9.9.1",
